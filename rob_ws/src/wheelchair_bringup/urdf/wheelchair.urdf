<?xml version="1.0"?>
<robot name="wheelchair">

  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.60 0.60 0.20"/>
      </geometry>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
    </visual>
  </link>

  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.10 0.05 0.05"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.22 0.0 1.07" rpy="0 0 0"/>
  </joint>

</robot>